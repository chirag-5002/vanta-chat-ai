# Discord Bot Credentials
# Get this from Discord Developer Portal -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=your_discord_bot_token_here

# Google Gemini API Key
# Get this from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Channels Configuration
# Comma-separated list of Discord channel IDs where the bot will automatically read and reply to questions without needing a mention.
# If left empty, the bot will ONLY respond when it is directly mentioned (@BotName) in channels it can read.
ALLOWED_CHANNELS=

# Path to the system instruction/FAQ file (relative to root)
SYSTEM_INSTRUCTION_FILE=./systemInstruction.txt
